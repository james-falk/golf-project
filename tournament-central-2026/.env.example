# Generate a long random secret before any public deployment.
SESSION_SECRET=replace-with-a-long-random-value

# Viewer passcode and commissioner/helper codes. Do not expose these with NEXT_PUBLIC_.
VIEWER_ACCESS_CODE=replace-before-deploying
COMMISSIONER_ACCESS_CODE=replace-before-deploying
HELPER_ACCESS_CODES=helper-one,helper-two

# Provision Neon Postgres through the Vercel Marketplace before production.
DATABASE_URL=
