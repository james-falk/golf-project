# Generate a long random secret before any public deployment.
AUTH_SECRET=replace-with-a-long-random-value

# Viewer and commissioner passcodes. Do not expose these with NEXT_PUBLIC_.
VIEWER_PASSCODE=replace-before-deploying
SCOREKEEPER_PASSCODE=replace-before-deploying

# Provision Neon Postgres through the Vercel Marketplace before production.
DATABASE_URL=

# Server-only credential used by the local Hermes scoring tool.
HERMES_SCORING_TOKEN=

# Optional one-time Jeff reaction audio generation. Keep the key server-only.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
